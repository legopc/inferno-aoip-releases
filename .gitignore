# Build outputs — never commit
output/
*.iso
*.raw
*.qcow2
*.vmdk

# Credentials — never commit
# build/config.toml contains SSH keys and password hashes
# The template version (with REPLACE_WITH_* placeholders) is committed.
# Your local version with real values should NOT be committed.
# Strategy: keep the template committed, keep your working copy outside git,
# or use a secrets manager.

# Stray ignition files with credentials
*.ign
build/*.json

# macOS
.DS_Store

# Editor
*.swp
*~
.idea/
.vscode/
