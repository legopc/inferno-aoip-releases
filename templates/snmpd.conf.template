# Inferno AoIP — snmpd configuration
# Generated by inferno-snmp-apply.sh from /etc/inferno.conf
# DO NOT EDIT by hand — changes will be overwritten on next apply.

# ── Access control ─────────────────────────────────────────────────────────────
# SNMPv2c read-only (community string set in /etc/inferno.conf)
rocommunity  %%INFERNO_SNMP_V2_COMMUNITY%%  default

# SNMPv3 read-only user (added by inferno-snmp-apply.sh when V3_USER is set)
# rouser %%INFERNO_SNMP_V3_USER%% authPriv

# ── System identity ────────────────────────────────────────────────────────────
sysName      %%INFERNO_NAME%%
sysDescr     Inferno AoIP Appliance
sysLocation  AoIP Network
sysContact   inferno@localhost

# ── Inferno OIDs via extend ───────────────────────────────────────────────────
# Exposed under NET-SNMP-EXTEND-MIB (.1.3.6.1.4.1.8072.1.3.2)
# Each extend name resolves to: .1.3.6.1.4.1.8072.1.3.2.3.1.2.<name-len>.<name-ascii>
extend inferno-version    /usr/local/sbin/inferno-snmp-oid.sh version
extend inferno-mode       /usr/local/sbin/inferno-snmp-oid.sh mode
extend inferno-name       /usr/local/sbin/inferno-snmp-oid.sh name
extend inferno-ptp        /usr/local/sbin/inferno-snmp-oid.sh ptp_offset
extend inferno-bridge     /usr/local/sbin/inferno-snmp-oid.sh service_bridge
extend inferno-librespot  /usr/local/sbin/inferno-snmp-oid.sh service_librespot
extend inferno-statime    /usr/local/sbin/inferno-snmp-oid.sh service_statime

# ── Daemon settings ────────────────────────────────────────────────────────────
# Listen on all interfaces (UDP 161)
agentAddress udp:161

# Reduce log noise on headless nodes
doNotLogTraps true
