[Unit]
Description=Net-SNMP daemon (Inferno AoIP read-only agent)
Documentation=https://github.com/legopc/inferno-aoip-releases
After=network-online.target inferno-configure.service
Wants=network-online.target
ConditionPathExists=/etc/inferno.conf
ConditionPathExists=/etc/snmp/snmpd.conf

[Service]
Type=simple
User=root
ExecStart=/usr/sbin/snmpd -f -Lo -c /etc/snmp/snmpd.conf
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
