[Unit]
Description=Inferno user service migration (sync templates on bootc upgrade)
Wants=network-online.target
After=network-online.target inferno-configure.service
ConditionPathExists=/etc/inferno.conf
# Run before user session starts so services load the new files
Before=user@1000.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/inferno-upgrade.sh

[Install]
WantedBy=multi-user.target
