[Unit]
Description=Inferno AUX RX Keepalive — holds Dante RX path open when idle
Documentation=https://gitlab.com/lumifaza/inferno
After=statime-inferno.service
After=inferno-aux-rx.service

[Service]
ExecStart=/usr/bin/arecord -D inferno_aux_rx -f S32_LE -r 48000 -c 2 /dev/null
Restart=always
RestartSec=5
# Never permanently give up — if aux-rx restarts or ALSA reinitialises, keepalive recovers
StartLimitBurst=0

[Install]
WantedBy=default.target
