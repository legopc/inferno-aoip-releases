[Unit]
Description=Inferno AUX RX Bridge — Dante to analog out
Documentation=https://gitlab.com/lumifaza/inferno
After=statime-inferno.service
After=default.target

[Service]
# Reads from the Inferno AUX RX device and plays to the physical analog output.
# %%INFERNO_AUDIO_CARD%% is replaced by inferno-deploy.sh from /etc/inferno.conf.
ExecStart=/usr/local/bin/Inferno-AUX-RX \
  -C inferno_aux_rx \
  -P plughw:%%INFERNO_AUDIO_CARD%%,0 \
  -r 48000 \
  -f S32_LE \
  -c 2 \
  -t 10000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
