[Unit]
Description=Inferno AUX TX Bridge — analog in to Dante
Documentation=https://gitlab.com/lumifaza/inferno
After=statime-inferno.service
After=default.target

[Service]
# Reads from the physical analog input and sends to the Inferno AUX TX Dante device.
# %%INFERNO_AUDIO_CARD%% is replaced by inferno-deploy.sh from /etc/inferno.conf.
# -t 10000 = 10ms transfer time. Use -t 20000 if xruns occur.
ExecStart=/usr/bin/alsaloop \
  -C plughw:%%INFERNO_AUDIO_CARD%%,0 \
  -P inferno_aux_tx \
  -r 48000 \
  -f S32_LE \
  -c 2 \
  -t 10000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
