[Unit]
Description=Librespot Spotify Connect
After=default.target
Wants=default.target

[Service]
ExecStartPre=/bin/sh -c 'while [ ! -S /tmp/ptp-usrvclock ]; do sleep 1; done'
# Only wait for PTP to stabilise on first boot (uptime < 60s).
ExecStartPre=/bin/sh -c 'UP=$(cut -d. -f1 /proc/uptime); [ "$UP" -gt 60 ] || sleep 10'
ExecStart=/usr/local/bin/librespot \
    --name "%%INFERNO_NAME%%" \
    --device-type avr \
    --backend alsa \
    --device spotifyd \
    --format S32 \
    --bitrate 320 \
    --volume-ctrl log \
    --initial-volume 50 \
    --autoplay off \
    --disable-audio-cache \
    --cache /var/home/core/.cache/librespot \
    --system-cache /var/home/core/.cache/librespot \
    --disable-gapless \
    --emit-sink-events \
    --onevent /var/home/core/bin/inferno-sink-event
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
