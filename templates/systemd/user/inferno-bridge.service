[Unit]
Description=Inferno AoIP ALSA Loopback Bridge
Documentation=https://gitlab.com/lumifaza/inferno
After=statime-inferno.service
After=default.target
Before=inferno-keepalive.service
Before=librespot.service
ConditionPathExists=/etc/inferno.conf

[Service]
# Bridges loopback capture → inferno_spotify, keeping DeviceServer permanently open.
# alsaloop with -t 20000 (20ms transfer window) and SAMPLERATE sync for clock drift.
# Invoked via Virgil-Appliance symlink — sets the Dante Controller "Model Name" field.
ExecStartPre=/bin/sh -c 'while [ ! -S /tmp/ptp-usrvclock ]; do sleep 1; done'
ExecStart=/usr/local/bin/Virgil-Appliance \
  -C hw:Loopback,1,0 \
  -P inferno_spotify \
  -r 48000 \
  -f S32_LE \
  -c 2 \
  -t 20000
Restart=always
RestartSec=3
TimeoutStopSec=5
LimitMEMLOCK=infinity

[Install]
WantedBy=default.target
