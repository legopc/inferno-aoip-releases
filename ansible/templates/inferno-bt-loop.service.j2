[Unit]
Description=Inferno Bluetooth Loopback → Dante TX
After=inferno-bt-bridge.service
Wants=inferno-bt-bridge.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'while [ ! -S /tmp/ptp-usrvclock ]; do sleep 1; done'
ExecStart=/usr/bin/alsaloop -C hw:Loopback,1,2 -P inferno_bluetooth -r 48000 -f S32_LE -c 2 -t 20000
Restart=always
RestartSec=5
# Restart every 6h to prevent inferno TX ring buffer lag accumulation.
# After >~14h uptime, a new Dante subscriber triggers a 115702-sample lag detection
# in flows_tx, which destroys the TX flow before any RTP is sent. This causes the
# "flow creation in progress → unresolved" loop in dante-doos inferno-aux-rx.
RuntimeMaxSec=6h

[Install]
WantedBy=default.target
